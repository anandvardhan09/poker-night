PORT=3001
# Comma-separated list of allowed web origins
CLIENT_ORIGIN=http://localhost:5173

# Supabase. Leave empty to run locally with name-only dev login + JSON file storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy HS256 JWT secret for fast local token verification.
# If unset, tokens are verified by calling Supabase Auth.
SUPABASE_JWT_SECRET=

# TURN relay (optional but recommended). Comma-separated URLs.
# e.g. Metered.ca: turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
